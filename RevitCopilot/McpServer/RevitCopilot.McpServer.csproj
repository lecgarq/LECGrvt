<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RevitCopilot.McpServer</AssemblyName>
    <RootNamespace>LECG.RevitCopilot.McpServer</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SkipRevitDeploy Condition="'$(SkipRevitDeploy)' == ''">false</SkipRevitDeploy>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Agent\CapabilityCatalog.cs" Link="CapabilityCatalog.cs" />
    <Compile Include="..\Agent\RevitApiCatalog.cs" Link="RevitApiCatalog.cs" />
    <Compile Include="..\Agent\ApiValidationEvidence.cs" Link="ApiValidationEvidence.cs" />
    <EmbeddedResource Include="..\Agent\Knowledge\revit2026-validation.json" LogicalName="LECG.Revit2026.Validation" />
    <Compile Include="..\Agent\ReviewedDiscovery.cs" Link="ReviewedDiscovery.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <Target Name="DeployMcpServer" AfterTargets="Build" Condition="'$(SkipRevitDeploy)' != 'true'">
    <PropertyGroup>
      <McpDeployDir>$(LOCALAPPDATA)\RevitCopilot\mcp</McpDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(McpDeployDir)" />
    <ItemGroup>
      <McpDeployFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpDeployFiles)" DestinationFiles="@(McpDeployFiles->'$(McpDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
</Project>
