<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Agent\Knowledge\revit2026-reference.json" LogicalName="LECG.Revit2026.Knowledge" />
    <EmbeddedResource Include="..\..\Agent\Knowledge\revit2026-validation.json" LogicalName="LECG.Revit2026.Validation" />
    <Compile Include="..\..\Agent\*.cs" Link="Agent\%(Filename)%(Extension)" />
    <Compile Include="..\..\Llm\IAgentClient.cs" Link="IAgentClient.cs" />
    <Compile Include="..\..\Llm\CodexAppServerClient*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\..\Llm\CodexModelOption.cs" Link="CodexModelOption.cs" />
    <Compile Include="..\..\Llm\CodexUsageState.cs" Link="CodexUsageState.cs" />
    <Compile Include="..\..\Llm\CopilotQuestionRequest.cs" Link="CopilotQuestionRequest.cs" />
    <Compile Include="..\..\Configuration\*.cs" Link="Configuration\%(Filename)%(Extension)" />
    <Compile Include="..\..\Models\ChatEntry.cs" Link="ChatEntry.cs" />
    <Compile Include="..\..\Models\ProjectContext.cs" Link="ProjectContext.cs" />
    <Compile Include="..\..\Services\ProjectConversationStore.cs" Link="ProjectConversationStore.cs" />
    <Compile Include="..\..\Services\SessionLogger.cs" Link="SessionLogger.cs" />
  </ItemGroup>
</Project>
