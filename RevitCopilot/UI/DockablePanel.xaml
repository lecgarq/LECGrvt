<UserControl x:Class="LECG.RevitCopilot.UI.DockablePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="340" Background="#F4F3EF" Foreground="#1E1E1C" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <!-- LECG Paper / Stone / Water / Ink, independent of the other add-in assembly. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4F3EF"/><Setter Property="Foreground" Value="#1E4257"/>
            <Setter Property="BorderBrush" Value="#C9C8C1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#1E4257"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#1E1E1C"/>
            <Setter Property="Background" Value="#F4F3EF"/><Setter Property="BorderBrush" Value="#C9C8C1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F4F3EF"/><Setter Property="Foreground" Value="#1E1E1C"/>
            <Setter Property="CaretBrush" Value="#1E4257"/><Setter Property="SelectionBrush" Value="#CFE0EB"/>
            <Setter Property="BorderBrush" Value="#C9C8C1"/><Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#C9C8C1" BorderThickness="0,0,0,1" Padding="16,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LECG / COPILOT" Foreground="#1E4257" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Revit 2026 · approval protected" Foreground="#4A4A47" FontSize="10" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready"
                           Foreground="#4A4A47" FontSize="11" MaxWidth="120" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <Border Margin="14,12,14,10" Padding="12" Background="#E4E3DE" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="PROJECT CONVERSATION" FontSize="10" FontWeight="SemiBold" Foreground="#4A4A47" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ProjectNameText" Text="Open a Revit project" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProjectSessionText" Text="History stays with your file" FontSize="11" Foreground="#4A4A47" TextWrapping="Wrap" Margin="0,5,0,8"/>
                    <Button x:Name="NewConversationButton" Content="＋ New chat" Click="NewConversation_OnClick" HorizontalAlignment="Left" Padding="10,4" FontSize="11"
                            ToolTip="Start fresh for this project. The previous conversation remains saved."/>
                </StackPanel>
            </Border>
            <Expander x:Name="SettingsExpander" IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="16,0,16,6">
                <Expander.Header><TextBlock x:Name="ModelSummaryText" Text="Model &amp; connection" FontWeight="SemiBold" FontSize="12"/></Expander.Header>
                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,10,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chat with" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="BackendSelector"
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="BackendSelector_OnSelectionChanged">
                    <ComboBoxItem Content="Codex · subscription" />
                    <ComboBoxItem Content="Direct API · provider credits" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,6,8,0" />
                <ComboBox x:Name="ModelSelector" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                          DisplayMemberPath="Label" SelectionChanged="ModelSelector_OnSelectionChanged"
                          ToolTip="Models reported by your signed-in Codex server." />
                <TextBlock Grid.Row="2" Text="Reasoning" VerticalAlignment="Center" Margin="0,6,8,0" />
                <ComboBox x:Name="EffortSelector" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" SelectionChanged="EffortSelector_OnSelectionChanged"
                          ToolTip="Reasoning efforts supported by the selected model." />
                <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <Button x:Name="RefreshModelsButton" Content="Refresh models" Padding="8,3"
                            Click="RefreshModels_OnClick" />
                    <Button x:Name="ReconnectButton" Content="Reconnect" Padding="8,3" Margin="6,0,0,0"
                            ToolTip="Reconnect without discarding your project conversation."
                            Click="Reconnect_OnClick" />
                </WrapPanel>
            </Grid>
                </ScrollViewer>
            </Expander>
                <Expander Margin="16,0,16,8" HorizontalContentAlignment="Stretch">
                    <Expander.Header><TextBlock x:Name="QuotaSummaryText" Text="Account usage · connecting" Foreground="#4A4A47" FontSize="11"/></Expander.Header>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock x:Name="QuotaText" Text="Connect to Codex to read usage." TextWrapping="Wrap" FontSize="11" />
                        <TextBlock x:Name="TokenUsageText" Text="Turn tokens: not reported yet" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                        <DockPanel Margin="0,5,0,0">
                            <Button x:Name="RefreshUsageButton" Content="Refresh usage" Padding="5,2" Click="RefreshUsage_OnClick" DockPanel.Dock="Right" />
                            <TextBlock x:Name="UsageUpdatedText" Text="Not refreshed yet" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Shared account quota · Windows local time. Token counts are activity, not remaining quota."
                                   FontSize="10" Foreground="#4A4A47" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander>
        </StackPanel>

        <ScrollViewer x:Name="ChatScroll"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,8,16,4">
            <StackPanel>
                <Button x:Name="OlderMessagesButton" Content="Show earlier messages" Click="OlderMessages_OnClick" Visibility="Collapsed" Margin="0,0,0,12"/>
                <Border x:Name="WelcomeCard" Margin="0,18,0,20" Padding="2,0">
                    <StackPanel>
                        <TextBlock Text="Your project, in context." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Inspect your model, check quantities, or preview a change. You stay in control of what gets applied."
                                   Foreground="#4A4A47" TextWrapping="Wrap" Margin="0,10,0,16"/>
                        <Button Content="Inspect this project →" HorizontalAlignment="Left" Click="InspectProject_OnClick" Margin="0,0,0,8"/>
                        <Button Content="Explore available tools →" HorizontalAlignment="Left" Click="ExploreTools_OnClick"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="MessageHost"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ApprovalHost" Margin="14,0"/>
            </ScrollViewer>
        <Border Margin="14,10,14,4" BorderBrush="#C9C8C1" BorderThickness="1" CornerRadius="9" Background="#F4F3EF" Padding="10,8">
            <StackPanel>
                <TextBlock Text="MESSAGE YOUR PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="#4A4A47" Margin="2,0,0,3"/>
            <TextBox x:Name="PromptInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="56"
                     MaxHeight="130"
                     Padding="2,6"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="PromptInput_OnKeyDown"
                     ToolTip="Enter a request. Press Ctrl+Enter to send." AutomationProperties.Name="Message your project"/>
                <TextBlock Text="Ctrl+Enter to send · Enter for a new line" FontSize="10" Foreground="#4A4A47"/>
            </StackPanel>
        </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="14,4,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectionButton"
                    Grid.Column="0"
                    Content="＋ Selection"
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Click="SelectionButton_OnClick" />
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    Padding="22,6"
                    Background="#1E4257"
                    Foreground="#F4F3EF"
                    FontWeight="SemiBold"
                    Click="SendButton_OnClick" />
        </Grid>
    </Grid>
</UserControl>
