<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LECG</RootNamespace>
    <AssemblyName>LECG</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SkipRevitDeploy>false</SkipRevitDeploy>
    <SkipRevitDeploy Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">true</SkipRevitDeploy>
    <!-- Code analysis for dead code detection -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CommunityToolkitMvvmSourceGeneratorIsEnabled>true</CommunityToolkitMvvmSourceGeneratorIsEnabled>
  </PropertyGroup>

  <!-- Revit 2026 API via reference-assembly NuGet packages (Nice3point) instead of a local
       install HintPath. Reference-only (not copied to output; Revit supplies the real DLLs at
       runtime), so this both keeps deployment behavior identical AND lets LECG.csproj build on
       CI runners that have no Revit installed. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Unofficial.Triangle.NET" Version="0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="src\Resources\Images\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="LECG.Core\LECG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LECG.Tests\**\*.cs" />
    <Compile Remove="LECG.Core\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="scripts\**\*.cs" />
  </ItemGroup>

  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(SkipRevitDeploy)' != 'true'">
    <PropertyGroup>
      <!-- Per-user add-in folder (Autodesk's recommended developer deploy; needs no admin rights).
           The manifest %APPDATA%\Autodesk\Revit\Addins\2026\LECG.addin points at LECG\LECG.dll relative to itself. -->
      <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\2026\LECG</RevitAddinsDir>
    </PropertyGroup>
    <Message Text="Deploying to Revit addins: $(RevitAddinsDir)" Importance="high" />
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)*.dll" />
      <DeployFiles Include="$(OutputPath)*.pdb" />
      <DeployFiles Include="$(OutputPath)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
