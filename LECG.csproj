<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LECG</RootNamespace>
    <AssemblyName>LECG</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>MSB3277;CS0436</NoWarn>
    <SkipRevitDeploy>false</SkipRevitDeploy>
    <SkipRevitDeploy Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">true</SkipRevitDeploy>
    <!-- Code analysis for dead code detection -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CommunityToolkitMvvmSourceGeneratorIsEnabled>true</CommunityToolkitMvvmSourceGeneratorIsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.201">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scrutor" Version="5.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Unofficial.Triangle.NET" Version="0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="src\Resources\Images\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="LECG.Core\LECG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LECG.Tests\**\*.cs" />
    <Compile Remove="LECG.Core\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(SkipRevitDeploy)' != 'true'">
    <PropertyGroup>
      <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\2027\LECG</RevitAddinsDir>
      <RevitAddinsParentDir>$(APPDATA)\Autodesk\Revit\Addins\2027</RevitAddinsParentDir>
    </PropertyGroup>
    <Message Text="Deploying to Revit addins: $(RevitAddinsDir)" Importance="high" />
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)*.dll" />
      <DeployFiles Include="$(OutputPath)*.pdb" />
      <DeployFiles Include="$(OutputPath)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\LECG.addin" DestinationFolder="$(RevitAddinsParentDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
