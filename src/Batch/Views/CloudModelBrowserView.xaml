<base:LecgWindow x:Class="LECG.Batch.Views.CloudModelBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utils"
    Title="Browse Cloud Models"
    Width="700" Height="550" MinWidth="550" MinHeight="400"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    WindowIcon="{x:Static icons:Icons.Home}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Browse Cloud Models" FontWeight="{DynamicResource WeightBold}"
                       FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LecgTextPrimary}"
                       Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Browse Autodesk Docs hubs, projects, and folders to select Revit models for the batch queue."
                       FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Browser Columns -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hubs / Projects -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="HUBS" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Hubs}"
                         SelectedItem="{Binding SelectedHub}"
                         DisplayMemberPath="Name"
                         BorderBrush="{DynamicResource LecgBorderLight}"/>
                <Button Grid.Row="2" Content="Load Hubs" Margin="0,4,0,0"
                        Style="{DynamicResource ModernButtonStyle}"
                        Command="{Binding LoadHubsCommand}"/>
            </Grid>

            <!-- Projects -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="PROJECTS" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         DisplayMemberPath="Name"
                         BorderBrush="{DynamicResource LecgBorderLight}"/>
            </Grid>

            <!-- Folders + Versions -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="FOLDERS / ITEMS" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding FolderItems}"
                         SelectedItem="{Binding SelectedFolder}"
                         DisplayMemberPath="Name"
                         BorderBrush="{DynamicResource LecgBorderLight}"/>
                <TextBlock Grid.Row="2" Text="REVIT VERSIONS" Style="{DynamicResource SectionHeaderStyle}" Margin="0,8,0,4"/>
                <ListBox Grid.Row="3" x:Name="VersionsList"
                         ItemsSource="{Binding Versions}"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Extended"
                         BorderBrush="{DynamicResource LecgBorderLight}"/>
            </Grid>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource LecgTextSecondary}"
                   Margin="0,6,0,4" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="{DynamicResource ButtonRowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Add Selected to Queue"
                    Style="{DynamicResource ModernButtonStyle}"
                    Click="OnAddToQueueClick"/>
            <Button Grid.Column="2" Content="Close"
                    Style="{DynamicResource ModernButtonSecondaryStyle}"
                    Click="OnCloseClick"/>
        </Grid>
    </Grid>
</base:LecgWindow>
