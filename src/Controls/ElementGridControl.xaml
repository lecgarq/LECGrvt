<UserControl x:Class="LECG.Controls.ElementGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LECG.Controls">
    <controls:LecgDataGrid x:Name="Grid"
                           ItemsSource="{Binding RowItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           SelectionMode="{Binding SelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CanUserSortColumns="True"
                           AutoGenerateColumns="False">
        <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Sel"      Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
            <DataGridTextColumn     Header="Type"     Binding="{Binding Type}"     Width="Auto" IsReadOnly="True" CanUserSort="True" SortMemberPath="Type"/>
            <DataGridTextColumn     Header="Category" Binding="{Binding Category}" Width="*"    IsReadOnly="True" CanUserSort="True" SortMemberPath="Category"/>
            <DataGridTextColumn     Header="Name"     Binding="{Binding Name}"     Width="*"    IsReadOnly="True" CanUserSort="True" SortMemberPath="Name"/>
            <DataGridTextColumn     Header="Status"   Binding="{Binding Status}"   Width="120"  IsReadOnly="True" CanUserSort="True" SortMemberPath="Status"/>
        </DataGrid.Columns>
    </controls:LecgDataGrid>
</UserControl>
