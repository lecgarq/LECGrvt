<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:LECG.Utils">

    <ResourceDictionary.MergedDictionaries>
        <!-- Level 1: Design Tokens (Primitives) -->
        <ResourceDictionary Source="Base/Colors.xaml"/>
        <ResourceDictionary Source="Base/Brushes.xaml"/>
        <ResourceDictionary Source="Base/Sizes.xaml"/>
        <ResourceDictionary Source="Base/Fonts.xaml"/>
        <ResourceDictionary Source="Animations.xaml"/>

        <!-- Level 2: Component Styles (Consuming Tokens) -->
        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="Controls.xaml"/>
        <ResourceDictionary Source="Containers.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared converters to avoid per-window StaticResource resolution failures -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    <utils:FilterStatusConverter x:Key="StatusColor"/>

</ResourceDictionary>
