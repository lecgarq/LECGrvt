<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Premium Color Palette (Source: Theme.cs) -->
    <Color x:Key="ColorWindowBackground">#FAFAFC</Color>
    <Color x:Key="ColorPanelBackground">#FFFFFF</Color>
    <Color x:Key="ColorContentBackground">#F7F8FA</Color>
    <Color x:Key="ColorBorder">#E2E4E9</Color>

    <Color x:Key="ColorPrimary">#2D3748</Color>
    <Color x:Key="ColorPrimaryHover">#1E2837</Color>

    <Color x:Key="ColorTextPrimary">#1A202C</Color>
    <Color x:Key="ColorTextSecondary">#718096</Color>
    <Color x:Key="ColorTextMuted">#A0AEC0</Color>

    <Color x:Key="ColorAlert">#C53030</Color>
    <Color x:Key="ColorSuccess">#38A169</Color>
    <Color x:Key="ColorLogText">#2D3748</Color>

    <Color x:Key="ColorLogBackground">#FFFFFF</Color>
    <Color x:Key="ColorGlassOverlay">#FFFFFF</Color>
    <Color x:Key="ColorCardBackground">#FFFFFF</Color>

    <!-- DataGrid Specifics -->
    <Color x:Key="ColorDataGridAdded">#00AA00</Color>
    <Color x:Key="ColorDataGridRemoved">#FF0000</Color>
    <Color x:Key="ColorDataGridMeta">#999999</Color>

    <!-- Premium Accent System (Indigo) -->
    <Color x:Key="ColorAccent">#4F46E5</Color>
    <Color x:Key="ColorAccentLight">#EEF2FF</Color>
    <Color x:Key="ColorAccentHover">#4338CA</Color>
    <Color x:Key="ColorAccentMuted">#818CF8</Color>

    <!-- Elevated Surfaces & Rows -->
    <Color x:Key="ColorSurfaceElevated">#F8FAFC</Color>
    <Color x:Key="ColorDataGridRowAlt">#F9FAFB</Color>
    <Color x:Key="ColorDataGridRowHover">#F1F5F9</Color>

    <!-- Scope Badge Colors -->
    <Color x:Key="ColorScopeActive">#EEF2FF</Color>
    <Color x:Key="ColorScopeActiveText">#4F46E5</Color>
    <Color x:Key="ColorScopeActiveBorder">#C7D2FE</Color>
    <Color x:Key="ColorScopeInactive">#F1F5F9</Color>
    <Color x:Key="ColorScopeInactiveText">#94A3B8</Color>
    <Color x:Key="ColorScopeInactiveBorder">#E2E8F0</Color>

</ResourceDictionary>
