<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes referencing Colors -->
    <!-- Brushes referencing Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource ColorWindowBackground}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource ColorPanelBackground}"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource ColorContentBackground}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource ColorBorder}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource ColorPanelBackground}"/>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{DynamicResource ColorPrimary}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource ColorPrimaryHover}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource ColorTextMuted}"/>

    <SolidColorBrush x:Key="AlertBrush" Color="{DynamicResource ColorAlert}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource ColorSuccess}"/>

    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{DynamicResource ColorLogBackground}"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="{DynamicResource ColorLogText}"/>
    <SolidColorBrush x:Key="GlassOverlayBrush" Color="{DynamicResource ColorGlassOverlay}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource ColorCardBackground}"/>

    <SolidColorBrush x:Key="DataGridAddedBrush" Color="{DynamicResource ColorDataGridAdded}"/>
    <SolidColorBrush x:Key="DataGridRemovedBrush" Color="{DynamicResource ColorDataGridRemoved}"/>
    <SolidColorBrush x:Key="DataGridMetaBrush" Color="{DynamicResource ColorDataGridMeta}"/>

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- Premium Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource ColorAccentLight}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource ColorAccentMuted}"/>

    <!-- Elevated Surfaces & Rows -->
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource ColorSurfaceElevated}"/>
    <SolidColorBrush x:Key="DataGridRowAltBrush" Color="{DynamicResource ColorDataGridRowAlt}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{DynamicResource ColorDataGridRowHover}"/>

    <!-- Scope Badge Brushes -->
    <SolidColorBrush x:Key="ScopeActiveBrush" Color="{DynamicResource ColorScopeActive}"/>
    <SolidColorBrush x:Key="ScopeActiveTextBrush" Color="{DynamicResource ColorScopeActiveText}"/>
    <SolidColorBrush x:Key="ScopeActiveBorderBrush" Color="{DynamicResource ColorScopeActiveBorder}"/>
    <SolidColorBrush x:Key="ScopeInactiveBrush" Color="{DynamicResource ColorScopeInactive}"/>
    <SolidColorBrush x:Key="ScopeInactiveTextBrush" Color="{DynamicResource ColorScopeInactiveText}"/>
    <SolidColorBrush x:Key="ScopeInactiveBorderBrush" Color="{DynamicResource ColorScopeInactiveBorder}"/>

    <!-- Premium Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ColorAccent}" Offset="0"/>
        <GradientStop Color="{DynamicResource ColorAccentHover}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ColorAccentHover}" Offset="0"/>
        <GradientStop Color="#3730A3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource ColorAccent}" Offset="0"/>
        <GradientStop Color="{DynamicResource ColorAccentMuted}" Offset="0.5"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
