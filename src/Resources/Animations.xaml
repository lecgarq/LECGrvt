<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Timing Constants -->
    <Duration x:Key="AnimationDuration">0:0:0.25</Duration>
    <Duration x:Key="QuickDuration">0:0:0.15</Duration>
    <Duration x:Key="SlowDuration">0:0:0.45</Duration>

    <!-- Easing Functions -->
    <QuarticEase x:Key="StandardEase" EasingMode="EaseInOut"/>
    <QuarticEase x:Key="ExitingEase" EasingMode="EaseIn"/>
    <QuarticEase x:Key="EnteringEase" EasingMode="EaseOut"/>
    <BackEase x:Key="ElasticEase" EasingMode="EaseOut" Amplitude="0.3"/>

    <!-- Common Animation Templates -->
    <Storyboard x:Key="PulseAnimation">
        <DoubleAnimation Storyboard.TargetProperty="ScaleX" From="1" To="1.05" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetProperty="ScaleY" From="1" To="1.05" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>
</ResourceDictionary>
