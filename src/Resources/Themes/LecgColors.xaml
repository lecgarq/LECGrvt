<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        LECG Graphic Standard LECG-GS-01 — colour (C:\LECG\Brand\STANDARD\LECG_STANDARD.md, Part 1).
        Sixteen colours in four families. Sixteen is the ceiling (C6): anything else on screen is
        a tint of one of these. Never pure black or pure white (C2). Blue is a mark, a line or
        type; Water is the only blue surface (C1).
    -->

    <!-- Identity -->
    <Color x:Key="BrandBlue">#1E4257</Color>
    <Color x:Key="BrandInk">#1E1E1C</Color>
    <Color x:Key="BrandGraphite">#4A4A47</Color>
    <Color x:Key="BrandPaper">#F4F3EF</Color>
    <!-- Landscape -->
    <Color x:Key="BrandSage">#8D9179</Color>
    <Color x:Key="BrandOlive">#A9AE96</Color>
    <Color x:Key="BrandLichen">#C5C8B7</Color>
    <Color x:Key="BrandMeadow">#DDE1D3</Color>
    <!-- Material -->
    <Color x:Key="BrandWalnut">#7A5F48</Color>
    <Color x:Key="BrandOak">#B99A72</Color>
    <Color x:Key="BrandTravertine">#CFC2AE</Color>
    <Color x:Key="BrandPlaster">#E5DCCE</Color>
    <!-- Mineral -->
    <Color x:Key="BrandSlate">#8A8A85</Color>
    <Color x:Key="BrandStone">#C9C8C1</Color>
    <Color x:Key="BrandChalk">#E4E3DE</Color>
    <Color x:Key="BrandWater">#CFE0EB</Color>

    <!-- ============================================================ -->
    <!-- ROLES — what the UI reaches for. Views use these, never Brand* -->
    <!-- ============================================================ -->

    <!-- Ground and surfaces: Paper is the sheet; panels sit on it in Chalk; inputs are wells cut back to Paper. -->
    <Color x:Key="LecgBaseBackgroundColor">#F4F3EF</Color>       <!-- 04 Paper -->
    <Color x:Key="LecgSurfaceBackgroundColor">#E4E3DE</Color>    <!-- 15 Chalk -->
    <Color x:Key="LecgInputBackgroundColor">#F4F3EF</Color>      <!-- 04 Paper -->
    <Color x:Key="LecgHoverBackgroundColor">#EAE9E5</Color>      <!-- 15 Chalk at 60 % over Paper -->
    <Color x:Key="LecgBorderLightColor">#C9C8C1</Color>          <!-- 14 Stone: hairline rules, table rules -->
    <Color x:Key="LecgBorderDarkColor">#8A8A85</Color>           <!-- 13 Slate: hover rules -->

    <!-- Type: Ink for body and titles, Graphite for secondary, Slate only for disabled and placeholders (3.1:1 — large text only). -->
    <Color x:Key="LecgTextPrimaryColor">#1E1E1C</Color>          <!-- 02 Ink -->
    <Color x:Key="LecgTextSecondaryColor">#4A4A47</Color>        <!-- 03 Graphite -->
    <Color x:Key="LecgTextMutedColor">#8A8A85</Color>            <!-- 13 Slate -->

    <!-- Accent: the mark colour. Blue fills a primary button or draws a focus ring; Water is its wash. Paper on Blue is an approved colourway. -->
    <Color x:Key="LecgAccentColor">#1E4257</Color>               <!-- 01 LECG Blue -->
    <Color x:Key="LecgAccentHoverColor">#1E1E1C</Color>          <!-- 02 Ink -->
    <Color x:Key="LecgAccentPressedColor">#4A4A47</Color>        <!-- 03 Graphite -->
    <Color x:Key="LecgAccentSoftColor">#CFE0EB</Color>           <!-- 16 Water: selection, checked chips, active rows -->
    <Color x:Key="LecgOnAccentColor">#F4F3EF</Color>             <!-- 04 Paper -->

    <!-- Status. Success and warning come from the palette; error is the one colour outside it —
         a real red is a safety signal and the standard has none. Soft variants are fills for badges and rows. -->
    <Color x:Key="LecgSuccessColor">#8D9179</Color>              <!-- 05 Sage -->
    <Color x:Key="LecgSuccessSoftColor">#DDE1D3</Color>          <!-- 08 Meadow -->
    <Color x:Key="LecgWarningColor">#7A5F48</Color>              <!-- 09 Walnut -->
    <Color x:Key="LecgWarningSoftColor">#E5DCCE</Color>          <!-- 12 Plaster -->
    <Color x:Key="LecgErrorColor">#C53030</Color>
    <Color x:Key="LecgErrorSoftColor">#EBCCC9</Color>            <!-- error at 20 % over Paper -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="LecgBaseBackground" Color="{StaticResource LecgBaseBackgroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgSurfaceBackground" Color="{StaticResource LecgSurfaceBackgroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgInputBackground" Color="{StaticResource LecgInputBackgroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgHoverBackground" Color="{StaticResource LecgHoverBackgroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgBorderLight" Color="{StaticResource LecgBorderLightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgBorderDark" Color="{StaticResource LecgBorderDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgTextPrimary" Color="{StaticResource LecgTextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgTextSecondary" Color="{StaticResource LecgTextSecondaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgTextMuted" Color="{StaticResource LecgTextMutedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgAccent" Color="{StaticResource LecgAccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgAccentHover" Color="{StaticResource LecgAccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgAccentPressed" Color="{StaticResource LecgAccentPressedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgAccentSoft" Color="{StaticResource LecgAccentSoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgOnAccent" Color="{StaticResource LecgOnAccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgSuccess" Color="{StaticResource LecgSuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgSuccessSoft" Color="{StaticResource LecgSuccessSoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgWarning" Color="{StaticResource LecgWarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgWarningSoft" Color="{StaticResource LecgWarningSoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgError" Color="{StaticResource LecgErrorColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LecgErrorSoft" Color="{StaticResource LecgErrorSoftColor}" po:Freeze="True"/>

</ResourceDictionary>
