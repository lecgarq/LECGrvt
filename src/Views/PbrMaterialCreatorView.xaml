<base:LecgWindow x:Class="LECG.Views.PbrMaterialCreatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utils"
    xmlns:converters="clr-namespace:LECG.Utils"
    Title="PBR MATERIAL CREATOR"
    Width="900"
    Height="820"
    MinWidth="780"
    MinHeight="640"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    WindowIcon="{x:Static icons:Icons.Material}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisCustom"/>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="PBR Material Creator" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LecgTextPrimary}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Select a folder with PBR textures. Maps are auto-detected by filename keywords (basecolor, normal, roughness, metallic, ao, opacity). Enter a material name and create." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- TAB BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding MaterialPages}"
                     SelectedItem="{Binding SelectedPage}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="tabBorder"
                                            Background="{DynamicResource LecgBaseBackground}"
                                            BorderBrush="{DynamicResource LecgBorderLight}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="10,6,6,6"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource LecgSurfaceBackground}"/>
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource LecgBorderDark}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource LecgBorderDark}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TabHeader}" FontSize="12" Foreground="{DynamicResource LecgTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="&#xD7;"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Padding="2,0"
                                    MinWidth="20"
                                    MinHeight="20"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.CanRemovePage, RelativeSource={RelativeSource AncestorType={x:Type base:LecgWindow}}, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType={x:Type base:LecgWindow}}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource TertiaryButtonStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Column="1"
                    Content="+ Add"
                    Command="{Binding AddPageCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="10,4"
                    FontSize="11"
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,0"/>
        </Grid>

        <!-- CONTENT AREA -->
        <Border Grid.Row="2"
                Background="{DynamicResource LecgSurfaceBackground}"
                BorderBrush="{DynamicResource LecgBorderDark}"
                BorderThickness="1"
                CornerRadius="0,4,4,4"
                Padding="18,14"
                Margin="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding SelectedPage}">
                <StackPanel>
                    <!-- MATERIAL IDENTITY -->
                    <TextBlock Text="MATERIAL IDENTITY" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Material Name" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Description" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Material Class" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox IsEditable="True"
                                      Text="{Binding MaterialClass, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DefaultMaterialClasses}"
                                      Height="34"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- FOLDER SELECTION -->
                    <TextBlock Text="TEXTURE FOLDER" Style="{DynamicResource SectionHeaderStyle}" Margin="0,8,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1"
                                Content="Browse Folder"
                                Command="{Binding BrowseFolderCommand}"
                                Margin="8,0,0,0"
                                Width="110"
                                Height="34"
                                Style="{DynamicResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Border Background="{DynamicResource LecgBaseBackground}" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                        <TextBlock FontSize="11" Foreground="{DynamicResource LecgTextMuted}" TextWrapping="Wrap">
                            <Run Text="Auto-detected"/>
                            <Run Text="{Binding DetectedCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="texture maps from folder. You can still override any channel manually below."/>
                        </TextBlock>
                    </Border>

                    <!-- DETECTED TEXTURES -->
                    <TextBlock Text="PBR CHANNELS" Style="{DynamicResource SectionHeaderStyle}" Margin="0,4,0,8"/>

                    <!-- Diffuse -->
                    <TextBlock Text="Diffuse / Albedo (required)" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DiffusePath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding DiffusePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="Diffuse" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="Diffuse" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- Normal -->
                    <TextBlock Text="Normal Map (required)" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NormalPath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding NormalPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="Normal" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="Normal" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- Roughness -->
                    <TextBlock Text="Roughness (required)" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RoughnessPath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding RoughnessPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="Roughness" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="Roughness" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- Metallic -->
                    <TextBlock Text="Metallic (required)" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding MetallicPath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding MetallicPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="Metallic" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="Metallic" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- AO -->
                    <TextBlock Text="Ambient Occlusion" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AoPath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding AoPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="AO" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="AO" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- Opacity -->
                    <TextBlock Text="Opacity / Alpha" Foreground="{DynamicResource LecgTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OpacityPath}" Height="36" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{DynamicResource LecgBaseBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                            <Image Source="{Binding OpacityPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" CommandParameter="Opacity" Margin="6,0,0,0" Width="36" Height="36" Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="X" Command="{Binding ClearPathCommand}" CommandParameter="Opacity" Margin="4,0,0,0" Width="36" Height="36"/>
                    </Grid>

                    <!-- INFO -->
                    <Border Background="{DynamicResource LecgBaseBackground}" CornerRadius="4" Padding="12" Margin="0,4,0,0">
                        <TextBlock Text="Materials use Revit's Advanced Opaque schema. Textures are re-baked to 8-bit PNG under a _revit folder next to the sources: AO is multiplied into base color, the normal map's green channel is flipped to OpenGL, and a metallic map becomes a reflectance (F0) map. Height maps are not used."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource LecgTextMuted}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BUTTONS -->
        <Grid Grid.Row="3" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel"
                    Grid.Column="0"
                    Height="{DynamicResource ButtonHeight}"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="Create Materials"
                    Grid.Column="2"
                    Height="{DynamicResource ButtonHeight}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanRun}"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
