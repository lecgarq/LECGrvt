<base:LecgWindow x:Class="LECG.Views.Base.LecgDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utilities"
    Title="LECG"
    Width="420" SizeToContent="Height"
    MinWidth="320" MaxWidth="560" MaxHeight="500"
    ResizeMode="NoResize"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    WindowIcon="{x:Static icons:Icons.Home}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Command-link option button -->
            <Style x:Key="OptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource LecgSurfaceBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource LecgTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LecgBorderLight}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SmallCornerRadius}"
                                    Padding="14,10">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource LecgAccent}"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource LecgBaseBackground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource LecgBorderLight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with accent bar -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="3" Height="14" CornerRadius="1.5"
                        Background="{DynamicResource LecgAccent}"
                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText"
                           Text="Dialog"
                           FontWeight="{DynamicResource WeightBold}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           Foreground="{DynamicResource LecgTextPrimary}"/>
            </StackPanel>
        </StackPanel>

        <!-- Main message -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Text=""
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource LecgTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>

        <!-- Detail text (optional, collapsed by default) -->
        <TextBlock x:Name="DetailText"
                   Grid.Row="2"
                   Text=""
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource LecgTextMuted}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,8"/>

        <!-- Options panel (for command-link dialogs, collapsed by default) -->
        <ItemsControl x:Name="OptionsPanel"
                       Grid.Row="3"
                       Visibility="Collapsed"
                       Margin="0,4,0,4"/>

        <!-- Button row -->
        <Grid x:Name="ButtonRow" Grid.Row="4" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    MinWidth="80"
                    Height="{DynamicResource ButtonHeightMedium}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Visibility="Collapsed"
                    Style="{DynamicResource SecondaryButtonStyle}"/>

            <Button x:Name="OkButton"
                    Grid.Column="3"
                    Content="OK"
                    MinWidth="80"
                    Height="{DynamicResource ButtonHeightMedium}"
                    Click="Ok_Click"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
