<base:LecgWindow x:Class="LECG.Views.SimplifyPointsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:comp="clr-namespace:LECG.Views.Components"
    xmlns:icons="clr-namespace:LECG.Utils" Title="SIMPLIFY POINTS" Width="380" WindowIcon="{x:Static icons:Icons.Simplify}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Simplify Toposolid Points" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Remove points to simplify the shape." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Selection -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="SELECTION" Style="{DynamicResource LabelStyle}" Margin="0,0,0,4" Opacity="0.5"/>
                <comp:SelectionControl DataContext="{Binding Selection}"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Height="{DynamicResource ButtonHeightMedium}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="Run" Grid.Column="2" Height="{DynamicResource ButtonHeightMedium}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}" Style="{DynamicResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>

