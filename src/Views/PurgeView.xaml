<base:LecgWindow x:Class="LECG.Views.PurgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utilities" Title="PURGE" Width="350" Height="450" MinWidth="300" MinHeight="400" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.Trash}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Purge Unused Elements" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LecgTextPrimary}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Remove unused styles, patterns, and materials from your project." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="1" Padding="16" Margin="{DynamicResource HeaderMarginSmall}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource LecgAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="OPTIONS" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Check All" Command="{Binding CheckAllCommand}" Style="{DynamicResource LinkButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Uncheck All" Command="{Binding UncheckAllCommand}" Style="{DynamicResource LinkButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <CheckBox Content="Unused Line Styles" IsChecked="{Binding PurgeLineStyles, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Line Patterns" IsChecked="{Binding PurgeLinePatterns, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Fill Patterns" IsChecked="{Binding PurgeFillPatterns, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Materials" IsChecked="{Binding PurgeMaterials, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Levels" IsChecked="{Binding PurgeLevels, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Groups" IsChecked="{Binding PurgeGroups, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Grid Types" IsChecked="{Binding PurgeGridTypes, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused Level Types" IsChecked="{Binding PurgeLevelTypes, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="All Constraints" IsChecked="{Binding PurgeConstraints, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}" ToolTip="Deletes EVERY deletable constraint (alignment locks, EQ, dimension locks) — not only unused ones. Constraints Revit refuses to delete are skipped."/>
                    <CheckBox Content="Unplaced Rooms" IsChecked="{Binding PurgeUnplacedRooms, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused View Templates" IsChecked="{Binding PurgeViewTemplates, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                    <CheckBox Content="Unused View Filters" IsChecked="{Binding PurgeViewFilters, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}"/>
                </StackPanel>
                <CheckBox Content="Unused Family Parameters (Warning)" IsChecked="{Binding PurgeParameters, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="{DynamicResource CheckboxSpacing}" ToolTip="Opens each family and removes parameters with no formula, no constraint, and no association. This is destructive and slow. Runs in both Safe and Deep mode."/>
                <Separator Margin="0,5,0,10" Background="{DynamicResource LecgBorderLight}"/>
                <CheckBox Content="Deep Purge (3 Passes)" IsChecked="{Binding IsDeepPurge, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" ToolTip="Runs Revit's native Purge Unused (everything unused) across the project and every editable family, then also applies the category selections above."/>
                <TextBlock Text="Deep Purge removes ALL unused elements via Revit's native purge, then additionally runs the checked categories above (native purge does not cover levels, types, rooms, view templates, or filters)." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="{DynamicResource ButtonRowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Height="{DynamicResource ButtonHeight}" Command="{Binding CancelCommand}" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}"/>

            <Button Content="Purge" Grid.Column="2" Height="{DynamicResource ButtonHeight}" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
