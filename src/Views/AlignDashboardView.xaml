<base:LecgWindow x:Class="LECG.Views.AlignDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utils" Title="ALIGN ELEMENTS" Height="400" Width="600" MinWidth="500" MinHeight="350" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.AlignCenter}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="ALIGNMENT TOOLS" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LecgTextPrimary}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Select an alignment action." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}"/>
        </StackPanel>

        <!-- 3 Columns for Alignment Types -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Horizontal -->
            <StackPanel Grid.Column="0" Margin="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource LecgAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HORIZONTAL" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Left" Click="AlignLeft_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignLeft_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Left" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Center" Click="AlignCenter_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignCenter_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Center" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Right" Click="AlignRight_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignRight_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Right" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Vertical -->
            <StackPanel Grid.Column="1" Margin="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource LecgAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VERTICAL" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Top" Click="AlignTop_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignTop_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Top" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Middle" Click="AlignMiddle_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignMiddle_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Middle" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Align Bottom" Click="AlignBottom_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/AlignBottom_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Bottom" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Distribute -->
            <StackPanel Grid.Column="2" Margin="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource LecgAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DISTRIBUTE" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Distribute Horizontally" Click="DistributeH_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/DistributeH_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Horizontal" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource DashboardCardStyle}" Height="60" ToolTip="Distribute Vertically" Click="DistributeV_Click" Margin="0,4">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LECG;component/src/Resources/Images/DistributeV_16.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Vertical" VerticalAlignment="Center" Foreground="{DynamicResource LecgTextPrimary}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</base:LecgWindow>
