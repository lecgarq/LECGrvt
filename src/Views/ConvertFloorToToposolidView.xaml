<base:LecgWindow x:Class="LECG.Views.ConvertFloorToToposolidView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utilities"
    xmlns:comp="clr-namespace:LECG.Views.Components"
    xmlns:controls="clr-namespace:LECG.Controls" Title="FLOOR TO TOPOSOLID" Width="400" Height="660" MinWidth="360" MinHeight="560" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.ArrowUpDown}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Floor to Toposolid" Style="{DynamicResource TitleStyle}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Convert Floor elements to Toposolid elements, preserving boundary shape and vertex positions." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Main Content -->
        <Border Grid.Row="1" Padding="16">
            <StackPanel>
                <!-- Selection Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                <TextBlock Text="SELECTION" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>

                <comp:SelectionControl DataContext="{Binding Selection}" Margin="0,0,0,16"/>
                <Border Background="{DynamicResource LecgSurfaceBackground}" BorderBrush="{DynamicResource LecgBorderLight}" BorderThickness="1" CornerRadius="{DynamicResource ContentCornerRadius}" Padding="8" Margin="0,0,0,16">
                    <controls:ElementGridControl RowItems="{Binding RowItems}" Height="120"/>
                </Border>

                <!-- Target Type Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="TARGET TYPE" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding TargetTypes}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name" Height="32" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- Target Level Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="TARGET LEVEL" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Name" Height="32" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- Options Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="OPTIONS" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <CheckBox Content="Delete source floors after conversion" IsChecked="{Binding DeleteSource}" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Height="{DynamicResource ButtonHeight}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>

            <Button Content="Convert" Grid.Column="2" Height="{DynamicResource ButtonHeight}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}" Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
