<base:LecgWindow x:Class="LECG.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:icons="clr-namespace:LECG.Utilities" Title="LECG TOOLKIT" Height="760" Width="900" MinWidth="800" MinHeight="600" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.Home}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A tool card: icon and name. The Tag is the key HomeCommand dispatches on. -->
            <Style x:Key="ToolCardStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DashboardCardStyle}">
                <Setter Property="Width" Value="184"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="ToolIconStyle" TargetType="{x:Type Image}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>
            <Style x:Key="ToolNameStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="18"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>
            <!-- Group header: 24 above, 8 below (S2). -->
            <Style x:Key="GroupHeaderStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="4,24,0,8"/>
            </Style>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: the mark (Blue on Paper, its default colourway) with its clear space, then the title. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgMark_Blue.png"
                   Height="56" VerticalAlignment="Center" Margin="0,0,48,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Toolkit" Style="{DynamicResource TitleStyle}" FontSize="{DynamicResource FontSizeExtraLarge}" Margin="0,0,0,2"/>
                <TextBlock Text="Select a tool to begin." Style="{DynamicResource CaptionStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Tools, grouped as on the ribbon. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="-4,0,0,0">

                <StackPanel Style="{StaticResource GroupHeaderStyle}" Margin="4,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="PROJECT HEALTH" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="CleanSchemas" Click="Tool_Click" ToolTip="Remove third-party plugin schemas from the project.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgCleanSchemas_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Clean Schemas"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="CompactStyles" Click="Tool_Click" ToolTip="Normalise duplicated line, fill and text styles into canonical definitions.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgCompactStyles_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Compact Styles"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="Purge" Click="Tool_Click" ToolTip="Purge unused line styles, line patterns, fill patterns and materials.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgPurgeUnused_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Purge Unused"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="FormulaGrouping" Click="Tool_Click" ToolTip="Move formula-driven parameters to the General/Other group across all families.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgFormulaGrouping_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Formula Grouping"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="Warnings" Click="Tool_Click" ToolTip="Review model warnings grouped by description, with select, show and isolate actions. Read-only.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgWarnings_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Warnings"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Style="{StaticResource GroupHeaderStyle}">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="STANDARDS" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ConvertCad" Click="Tool_Click" ToolTip="Convert imported CAD to cleaned Detail Item families.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgCadBlocks_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="CAD Blocks"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="BatchRename" Click="Tool_Click" ToolTip="Find and replace text or remove characters from element names.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgBatchRename_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Batch Rename"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ConvertFamily" Click="Tool_Click" ToolTip="Convert a hosted family instance to a work plane-based generic model.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgConvertFamily_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Convert Family"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="CategoryChanger" Click="Tool_Click" ToolTip="Switch instance categories by modifying the family definition silently.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgCategoryChanger_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Category Changer"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="SharedToFamilyParam" Click="Tool_Click" ToolTip="Bulk-convert shared parameters in families to non-shared family parameters.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgSharedToFamilyParam_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Shared to Family Param"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="FilterCopy" Click="Tool_Click" ToolTip="Copy view filters between views and templates.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgFilterCopy_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Filter Copy"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Style="{StaticResource GroupHeaderStyle}">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="TOPOSOLIDS" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AssignMaterial" Click="Tool_Click" ToolTip="Create and assign materials based on Floor and Toposolid type names.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAssignMaterial_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Assign Material"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="Offsets" Click="Tool_Click" ToolTip="Offset height from level for Toposolids and Floors.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgOffsetElevations_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Offset Elevations"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ResetSlabs" Click="Tool_Click" ToolTip="Reset slab shapes for Toposolids and Floors.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgResetSlabs_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Reset Slabs"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="SimplifyPoints" Click="Tool_Click" ToolTip="Remove redundant sub-element points from Toposolids while preserving shape.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgSimplifyPoints_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Simplify Points"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignEdges" Click="Tool_Click" ToolTip="Align points of one Toposolid to the surface of another.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignEdges_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Edges"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="UpdateContours" Click="Tool_Click" ToolTip="Apply or remove contour display on Toposolids.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgUpdateContours_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Update Contours"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ChangeLevel" Click="Tool_Click" ToolTip="Move Toposolids to a new level while maintaining absolute elevation.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgChangeLevel_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Change Level"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ConvertFloorToToposolid" Click="Tool_Click" ToolTip="Convert Floors to Toposolids preserving shape points and elevations.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgFloorToToposolid_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Floor to Toposolid"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="ConvertToposolidToFloor" Click="Tool_Click" ToolTip="Convert Toposolids to Floors preserving edited points and elevations.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgToposolidToFloor_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Toposolid to Floor"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="FixPoints" Click="Tool_Click" ToolTip="Repair inconsistent edge and transition points on Floors and Toposolids.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgFixPoints_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Fix Points"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="SplitBoundaries" Click="Tool_Click" ToolTip="Separate multi-boundary elements into independent instances.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgSplitBoundaries_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Split Boundaries"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="DivideToposolid" Click="Tool_Click" ToolTip="Split multi-layer toposolids into individual single-layer toposolids.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgDivideToposolid_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Divide Toposolid"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Style="{StaticResource GroupHeaderStyle}">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="ALIGN" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignLeft" Click="Tool_Click" ToolTip="Align selected elements to the left of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignLeft_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Left"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignCenter" Click="Tool_Click" ToolTip="Align selected elements to the horizontal centre of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignCenter_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignRight" Click="Tool_Click" ToolTip="Align selected elements to the right of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignRight_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Right"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignTop" Click="Tool_Click" ToolTip="Align selected elements to the top of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignTop_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignMiddle" Click="Tool_Click" ToolTip="Align selected elements to the vertical centre of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignMiddle_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Middle"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="AlignBottom" Click="Tool_Click" ToolTip="Align selected elements to the bottom of the reference element.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgAlignBottom_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Align Bottom"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="DistributeH" Click="Tool_Click" ToolTip="Distribute selected elements evenly horizontally.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgDistributeH_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Distribute Horizontally"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="DistributeV" Click="Tool_Click" ToolTip="Distribute selected elements evenly vertically.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgDistributeV_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Distribute Vertically"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Style="{StaticResource GroupHeaderStyle}">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="MODEL ORGANIZATION" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="TypeToLinked" Click="Tool_Click" ToolTip="Separate model content by type into individual linked Revit files.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgTypeToLinked_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Type to Linked"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Style="{StaticResource GroupHeaderStyle}">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="VISUALIZATION" Style="{DynamicResource SectionHeaderStyle}"/>
                </StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource ToolCardStyle}" Tag="RenderMatch" Click="Tool_Click" ToolTip="Sync graphics and identity with render appearance.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgRenderMatch_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Render Match"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="PbrMaterial" Click="Tool_Click" ToolTip="Create a render-ready material from diffuse, roughness and bump textures.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgPbrMaterial_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="PBR Material"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource ToolCardStyle}" Tag="SexyRevit" Click="Tool_Click" ToolTip="Optimise the view for presentation.">
                        <DockPanel>
                            <Image Style="{StaticResource ToolIconStyle}" Source="pack://application:,,,/LECG;component/src/Resources/Images/LecgSexyRevit_32.png"/>
                            <TextBlock Style="{StaticResource ToolNameStyle}" Text="Sexy Revit"/>
                        </DockPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</base:LecgWindow>
