<base:LecgWindow x:Class="LECG.Views.AlignEdgesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:utils="clr-namespace:LECG.Utilities"
    xmlns:icons="clr-namespace:LECG.Utilities"
    xmlns:comp="clr-namespace:LECG.Views.Components" Title="Align Edges" Width="420" Height="450" MinWidth="400" MinHeight="400" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.Contours}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Align Slab Edges" Style="{DynamicResource TitleStyle}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Align source slab boundaries vertically to nearby or selected reference geometry." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}"/>
        </StackPanel>

        <!-- Selection Cards -->
        <StackPanel Grid.Row="1" Margin="{DynamicResource HeaderMarginSmall}">
            <!-- Target Selection -->
            <Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{DynamicResource AccentBarStyle}"/>
                        <TextBlock Text="1. SOURCES" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                    <comp:SelectionControl DataContext="{Binding TargetsSelection}"/>
                </StackPanel>
            </Border>

            <!-- Find My Edge Toggle -->
            <CheckBox Content="Find my edge" IsChecked="{Binding FindMyEdge}" Margin="0,12,0,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextPrimary}" ToolTip="Automatically scan surrounding floors, toposolids, and links for local boundary drivers"/>

            <!-- Reference Selection (hidden when Find My Edge is checked) -->
            <Border Margin="{DynamicResource CardMarginNone}" Visibility="{Binding ShowReferenceSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{DynamicResource AccentBarStyle}"/>
                        <TextBlock Text="2. REFERENCES" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                    <comp:SelectionControl DataContext="{Binding ReferenceSelection}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Height="{DynamicResource ButtonHeight}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>

            <Button Grid.Column="2" Height="{DynamicResource ButtonHeight}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static icons:Icons.ArrowUpDown}" Stroke="White" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Run" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</base:LecgWindow>

