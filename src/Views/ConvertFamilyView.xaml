<base:LecgWindow x:Class="LECG.Views.ConvertFamilyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:comp="clr-namespace:LECG.Views.Components"
    xmlns:icons="clr-namespace:LECG.Utils" Title="CONVERT FAMILY" Height="600" Width="900" WindowIcon="{x:Static icons:Icons.Circle}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Convert Family" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Convert hosted family to work plane based generic model." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Selection -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="16" Margin="{DynamicResource HeaderMarginSmall}">
            <StackPanel>
                <TextBlock Text="SELECTION" Style="{DynamicResource LabelStyle}" Margin="0,0,0,4" Opacity="0.5"/>
                <comp:SelectionControl DataContext="{Binding Selection}"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <StackPanel Grid.Row="2">
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="NEW FAMILY NAME" Style="{DynamicResource CardHeaderStyle}"/>
                    <TextBox Text="{Binding NewFamilyName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TEMPLATE" Style="{DynamicResource CardHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseTemplateCommand}" Width="30" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="{DynamicResource CardMarginNone}">
                <StackPanel>
                    <TextBlock Text="OPTIONS" Style="{DynamicResource CardHeaderStyle}"/>
                    <CheckBox Content="Do not save (Temporary Load)" IsChecked="{Binding IsTemporary, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}" Margin="0,0,0,8"/>
                    <CheckBox Content="Replace Existing Instances In-Place" IsChecked="{Binding ReplaceInPlace, Mode=TwoWay}" Style="{DynamicResource ModernCheckboxStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="{DynamicResource ButtonRowMarginSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Command="{Binding CancelCommand}" Height="{DynamicResource ButtonHeightMedium}" Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="Convert" Grid.Column="2" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}" Height="{DynamicResource ButtonHeightMedium}" Style="{DynamicResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
