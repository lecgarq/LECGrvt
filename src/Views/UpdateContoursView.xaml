<base:LecgWindow x:Class="LECG.Views.UpdateContoursView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:utils="clr-namespace:LECG.Utils"
    xmlns:icons="clr-namespace:LECG.Utils" Title="UPDATE CONTOURS (LAYERS)" Width="500" Height="450" MinWidth="450" MinHeight="400" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.Contours}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Mode Toggle -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="UPDATE CONTOURS" FontWeight="{DynamicResource WeightBold}" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LecgTextPrimary}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Configure contour display on Toposolids." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}"/>
        </StackPanel>

        <!-- Mode Toggle -->
        <Border Grid.Row="1" Background="{DynamicResource LecgBaseBackground}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="15" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="Mode" FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource LecgTextSecondary}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ApplyModeRadio" Content="Apply Contours" IsChecked="{Binding IsApplyMode}" GroupName="Mode" Foreground="{DynamicResource LecgTextPrimary}" Margin="0,0,20,0" Cursor="Hand"/>
                    <RadioButton x:Name="RemoveModeRadio" Content="Remove Contours" GroupName="Mode" Foreground="{DynamicResource LecgTextPrimary}" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toposolid Types -->
            <Border Grid.Column="0" Background="{DynamicResource LecgBaseBackground}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="15" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Command="{Binding ToggleTypesExpandedCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTypesExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Toposolid Types" FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource LecgTextSecondary}" FontSize="{DynamicResource FontSizeSmall}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8" Visibility="{Binding IsTypesExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Check All" Command="{Binding CheckAllCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                        <Button Content="Uncheck All" Command="{Binding UncheckAllCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTypesExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ToposolidTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckboxStyle}" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Contour Settings -->
            <Border Grid.Column="1" Background="{DynamicResource LecgBaseBackground}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="15" Margin="5,0,0,0" IsEnabled="{Binding IsApplyMode}">
                <StackPanel>
                    <TextBlock Text="Contour Settings" FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource LecgTextSecondary}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource LecgSurfaceBackground}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox Content="Primary Contours" IsChecked="{Binding EnablePrimary}" Style="{DynamicResource ModernCheckboxStyle}" FontWeight="{DynamicResource WeightSemiBold}" Margin="0,0,0,8"/>
                            <Grid IsEnabled="{Binding EnablePrimary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interval:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                                <TextBox Grid.Column="1" Text="{Binding PrimaryInterval, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="8,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="m" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource LecgSurfaceBackground}" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <CheckBox Content="Secondary Contours" IsChecked="{Binding EnableSecondary}" Style="{DynamicResource ModernCheckboxStyle}" FontWeight="{DynamicResource WeightSemiBold}" Margin="0,0,0,8"/>
                            <Grid IsEnabled="{Binding EnableSecondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interval:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                                <TextBox Grid.Column="1" Text="{Binding SecondaryInterval, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="8,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="m" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Height="{DynamicResource ButtonHeight}" Margin="0,0,10,0"/>
            <Button Content="Run" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Width="120" Height="{DynamicResource ButtonHeight}"/>
        </StackPanel>
    </Grid>

</base:LecgWindow>
