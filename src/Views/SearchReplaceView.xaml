<base:LecgWindow x:Class="LECG.Views.SearchReplaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:controls="clr-namespace:LECG.Controls"
    xmlns:local="clr-namespace:LECG.Views"
    xmlns:vm="clr-namespace:LECG.ViewModels"
    xmlns:models="clr-namespace:LECG.Models"
    xmlns:services="clr-namespace:LECG.Services"
    xmlns:utils="clr-namespace:LECG.Utilities"
    xmlns:icons="clr-namespace:LECG.Utilities" mc:Ignorable="d" Title="BATCH RENAME" Width="680" Height="600" MinWidth="640" MinHeight="500" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.SearchReplace}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Scope & Filters -->
            <RowDefinition Height="Auto"/>
            <!-- Operations -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <!-- Section 2 divider -->
            <!-- 2. SCOPE & FILTERS                                     -->
            <!-- Scope and filters -->
            <Border Grid.Row="0" Background="{DynamicResource LecgSurfaceBackground}" CornerRadius="4" Margin="16,10,16,8" Padding="16,14,16,14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.03" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Scope -->
                        <RowDefinition Height="Auto"/>
                        <!-- Filters -->
                    </Grid.RowDefinitions>

                    <!-- Scope section -->
                    <StackPanel Grid.Row="0">
                        <!-- Section Header with accent bar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SCOPE" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <!-- Pill Badges -->
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox Content="Types" IsChecked="{Binding ScopeTypeName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Families" IsChecked="{Binding ScopeFamilyName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Views" IsChecked="{Binding ScopeViewName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Sheets" IsChecked="{Binding ScopeSheetName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Materials" IsChecked="{Binding ScopeMaterialName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Object Styles" IsChecked="{Binding ScopeObjectStyleName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Line Styles" IsChecked="{Binding ScopeLineStyleName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Patterns" IsChecked="{Binding ScopeFillPatternName}" Style="{DynamicResource PillCheckboxStyle}"/>
                            <CheckBox Content="Parameters" IsChecked="{Binding ScopeFamilyParameterName}" Style="{DynamicResource PillCheckboxStyle}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Filters section -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource LecgAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FILTERS" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Filter by Name" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" SelectedItem="{Binding SelectedFilterType}" ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type models:SearchFilterType}}}" Height="30" Width="110" VerticalContentAlignment="Center" Margin="0,0,5,0" Padding="5,0"/>

                                    <TextBox Grid.Column="1" Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

                                    <Button Grid.Column="2" Content="_" ToolTip="Replace Spaces with Underscore" Command="{Binding ReplaceSpacesCommand}" Width="25" Height="30" Margin="5,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Padding="0" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Filter by Category" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>

                                <!-- Multi-select with per-category row counts and typeahead.
                                     A plain ComboBox could only ever pick one category, and
                                     picking blind told you nothing about whether it would
                                     leave three rows or three thousand.

                                     Inline panel, not a Popup: a Popup with StaysOpen="False"
                                     captures the mouse, so clicking the button while open
                                     closes it and the same click immediately reopens it. And
                                     the button cannot be a ToggleButton — SecondaryButtonStyle
                                     is TargetType="Button", and ToggleButton derives from
                                     ButtonBase, not Button, which throws at window
                                     construction. -->
                                <StackPanel>
                                    <Button Height="30" Padding="8,0"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding ToggleCategoryDropDownCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoryFilterSummary}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSizeSmall}"/>
                                            <TextBlock Grid.Column="1" Text="▼" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Button>

                                    <Border Margin="0,4,0,0" Padding="8"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource ContentCornerRadius}"
                                            Visibility="{Binding IsCategoryDropDownOpen, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBox Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="26" Margin="0,0,0,6" VerticalContentAlignment="Center"
                                                     FontSize="{DynamicResource FontSizeSmall}"
                                                     ToolTip="Type to narrow the list"/>
                                            <ItemsControl ItemsSource="{Binding VisibleCategoryOptions}"
                                                          MaxHeight="180"
                                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Style="{DynamicResource ModernCheckboxStyle}"
                                                                  Margin="0,2"
                                                                  FontSize="{DynamicResource FontSizeSmall}">
                                                            <TextBlock>
                                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                <Run Text="{Binding Count, Mode=OneWay, StringFormat=({0})}"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Advanced filters - parameters -->
                            <Expander Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsParameterScope, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=">" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Advanced Parameter Filters" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Group -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Parameter Group" Style="{DynamicResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableParamGroups}" SelectedItem="{Binding FilterParamGroup}" Height="26" Padding="5,0"/>
                                    </StackPanel>

                                    <!-- Instance/Type -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Storage Type" Style="{DynamicResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="{Binding FilterIsInstanceIndex}" Height="26" Padding="5,0">
                                                <ComboBoxItem Content="All"/>
                                                <ComboBoxItem Content="Instance"/>
                                                <ComboBoxItem Content="Type"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ReadOnly -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Read Only?" Style="{DynamicResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="{Binding FilterIsReadOnlyIndex}" Height="26" Padding="5,0">
                                                <ComboBoxItem Content="All"/>
                                                <ComboBoxItem Content="Yes (Read Only)"/>
                                                <ComboBoxItem Content="No (Editable)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Expander>

                            <!-- Advanced filters - views -->
                            <Expander Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsViewScope, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=">" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Advanced View Filters" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="View Type" Style="{DynamicResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableViewTypes}" SelectedItem="{Binding FilterViewType}" Height="26" Padding="5,0"/>
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section 3 divider -->
            <!-- 3. OPERATIONS                                          -->
            <!-- Operations -->
            <Border Grid.Row="1" Background="Transparent" Margin="16,0,16,10">
                <StackPanel>
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="OPERATIONS" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. RegEx / Replace -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="RegEx / Replace" IsChecked="{Binding ReplaceRule.IsActive}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <Grid IsEnabled="{Binding ReplaceRule.IsActive}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Match:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ReplaceRule.FindText, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Height="24" VerticalContentAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Padding="2"/>

                                    <TextBlock Grid.Row="2" Text="Replace:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="5,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ReplaceRule.ReplaceText, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Padding="2"/>
                                        <Button Grid.Column="1" Content="_" ToolTip="Replace Spaces with Underscore" Command="{Binding ReplaceSpacesInReplaceTextCommand}" Width="20" Height="24" Margin="5,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Padding="0" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox Content="Case" IsChecked="{Binding ReplaceRule.MatchCase}" Style="{DynamicResource ModernCheckboxStyle}" Margin="0,0,10,0" FontSize="{DynamicResource FontSizeSmall}"/>
                                        <CheckBox Content="RegEx" IsChecked="{Binding ReplaceRule.UseRegex}" Style="{DynamicResource ModernCheckboxStyle}" FontSize="{DynamicResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Case -->
                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="Case" IsChecked="{Binding CaseRule.IsActive}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <Grid IsEnabled="{Binding CaseRule.IsActive}">
                                    <ComboBox SelectedItem="{Binding CaseRule.Mode}" ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type services:CaseMode}}}" Height="24" VerticalContentAlignment="Center" FontSize="{DynamicResource FontSizeSmall}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Remove -->
                        <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="Remove" IsChecked="{Binding RemoveRule.IsActive}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <Grid IsEnabled="{Binding RemoveRule.IsActive}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="First n:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding RemoveRule.FirstN, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="Last n:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="4" Text="{Binding RemoveRule.LastN, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="From:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemoveRule.FromPos, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Count:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RemoveRule.Count, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Add -->
                        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="Add" IsChecked="{Binding AddRule.IsActive}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <Grid IsEnabled="{Binding AddRule.IsActive}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Prefix:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding AddRule.Prefix, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

                                    <TextBlock Grid.Row="2" Text="Insert:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="5,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AddRule.Insert, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Padding="2"/>
                                        <TextBlock Grid.Column="1" Text="at" Margin="5,0,5,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="2" Text="{Binding AddRule.AtPos, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="{DynamicResource FontSizeSmall}"/>
                                    </Grid>

                                    <TextBlock Grid.Row="4" Text="Suffix:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AddRule.Suffix, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" Padding="2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. Numbering -->
                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="Numbering" IsChecked="{Binding NumberingRule.IsActive}" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <Grid IsEnabled="{Binding NumberingRule.IsActive}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mode:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding NumberingRule.Mode}" ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type services:NumberingMode}}}" Height="24" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}"/>

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding NumberingRule.StartAt, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Incr:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" Text="{Binding NumberingRule.Increment, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>
                                    </Grid>

                                    <Grid Grid.Row="4" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sep:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding NumberingRule.Separator, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="Pad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" Text="{Binding NumberingRule.Padding, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="5,0,0,0" FontSize="{DynamicResource FontSizeSmall}" HorizontalContentAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Extension (Placeholder) -->
                        <Border Grid.Row="2" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.5">
                            <StackPanel>
                                <CheckBox Content="Extension" IsChecked="False" IsEnabled="False" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,0,0,8" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock Text="(Coming Soon)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 4 divider -->
            <!-- 4. PREVIEW / DATAGRID                                  -->
            <!-- Preview and data grid -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource ContentCornerRadius}" Margin="16,0,16,10" Padding="12" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.03" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Column filter bar -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Status bar -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header + Select All/None Links -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PREVIEW" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,8,0"/>
                            <!-- Counts follow the ACTIVE FILTER. Binding PreviewItems.Count
                                 here reported the unfiltered total while the grid showed
                                 filtered rows, so the number lied the moment you filtered. -->
                            <TextBlock Style="{DynamicResource StatusBarTextStyle}" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="({0} shown · {1} selected)">
                                        <Binding Path="VisibleCount"/>
                                        <Binding Path="CheckedCount"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{DynamicResource LinkButtonStyle}" Margin="0,0,10,0"
                                    ToolTip="Tick every row currently shown. Rows hidden by a filter are not touched."/>
                            <Button Content="Select None" Command="{Binding SelectNoneCommand}" Style="{DynamicResource LinkButtonStyle}" Margin="0,0,10,0"
                                    ToolTip="Untick every row currently shown."/>
                            <Button Content="Invert" Command="{Binding InvertSelectionCommand}" Style="{DynamicResource LinkButtonStyle}"
                                    ToolTip="Flip the tick on every row currently shown."/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid — bound to PreviewView (ICollectionView) so WPF honours
                         SortDescriptions[0]=(Category, Asc) and the AND-combined Filter
                         (FilterCategory dropdown ∧ per-column predicates).
                         Column order locked by CONTEXT.md: ☑ | Type | Category | Original | New | Status. -->
                    <!-- Per-column filters (R8). These route through SetColumnFilter, which
                         already existed on the ViewModel and which nothing in this file
                         reached — the feature was fully plumbed and unreachable. A bar rather
                         than five header templates: same behaviour, far less XAML, and no
                         fragile alignment against virtualized column widths. -->
                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6" CornerRadius="4"
                            Background="{DynamicResource LecgSurfaceBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Style="{DynamicResource LabelStyle}"/>
                            <TextBox  Grid.Row="1" Grid.Column="0" Height="24" FontSize="{DynamicResource FontSizeSmall}" VerticalContentAlignment="Center"
                                      Text="{Binding FilterColType, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Style="{DynamicResource LabelStyle}"/>
                            <TextBox  Grid.Row="1" Grid.Column="2" Height="24" FontSize="{DynamicResource FontSizeSmall}" VerticalContentAlignment="Center"
                                      Text="{Binding FilterColCategory, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Original" Style="{DynamicResource LabelStyle}"/>
                            <TextBox  Grid.Row="1" Grid.Column="4" Height="24" FontSize="{DynamicResource FontSizeSmall}" VerticalContentAlignment="Center"
                                      Text="{Binding FilterColOriginal, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="New" Style="{DynamicResource LabelStyle}"/>
                            <TextBox  Grid.Row="1" Grid.Column="6" Height="24" FontSize="{DynamicResource FontSizeSmall}" VerticalContentAlignment="Center"
                                      Text="{Binding FilterColNew, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="8" Text="Status" Style="{DynamicResource LabelStyle}"/>
                            <TextBox  Grid.Row="1" Grid.Column="8" Height="24" FontSize="{DynamicResource FontSizeSmall}" VerticalContentAlignment="Center"
                                      Text="{Binding FilterColStatus, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="1" Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveFilterSummary}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource LecgAccent}"
                                           Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                        Style="{DynamicResource LinkButtonStyle}"
                                        IsEnabled="{Binding HasActiveFilters}"
                                        ToolTip="Clear the name filter, every column filter, and the category selection."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:LecgDataGrid Grid.Row="2" ItemsSource="{Binding PreviewView}" CanUserSortColumns="True">
                        <!-- Muted-row Style: skipped rows (IsRenameable=false) rendered at reduced
                             opacity with muted text so users can distinguish them at a glance. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenameable}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Sel checkbox: IsEnabled bound to IsRenameable so skipped rows cannot be ticked -->
                            <DataGridTemplateColumn Header="Sel" Width="35" SortMemberPath="IsChecked">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsRenameable}"
                                                  PreviewMouseLeftButtonDown="SelCheckBox_PreviewMouseLeftButtonDown"
                                                  ToolTip="Shift-click to set every row between this and the last one you clicked."
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" IsReadOnly="True" SortMemberPath="Type"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" IsReadOnly="True" SortMemberPath="Category"/>
                            <DataGridTextColumn Header="Original" Binding="{Binding OriginalValue}" Width="*" IsReadOnly="True" SortMemberPath="OriginalValue"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="*" IsReadOnly="True" Foreground="{DynamicResource LecgAccent}" SortMemberPath="NewValue"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" SortMemberPath="Id"/>
                            <!-- Status: shows skip reason or side-effect count; tooltip for overflow -->
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True" SortMemberPath="Status">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Status}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </controls:LecgDataGrid>

                    <!-- Busy overlay — covers the grid while CollectBaseElements runs.
                         Declared after the DataGrid in the same cell so it paints on top.
                         Deliberately static: CollectBaseElements is Revit API and blocks the
                         UI thread, so an animated ProgressBar would sit frozen and read as a
                         hang. A still panel that says what is happening is honest. -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            CornerRadius="{DynamicResource ContentCornerRadius}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BusyMessage}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource LecgAccent}"/>
                            <TextBlock Text="Revit is scanning the model — this runs once per scope."
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" Margin="0,6,0,0" Padding="0,4,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBlock Style="{DynamicResource StatusBarTextStyle}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} rows shown · {1} will be renamed">
                                    <Binding Path="VisibleCount"/>
                                    <Binding Path="CheckedCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Section 5 divider -->
            <!-- 5. FOOTER                                              -->
            <!-- Footer -->
            <Grid Grid.Row="3" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ValidationMessage}" VerticalAlignment="Center" Foreground="#B42318" TextWrapping="Wrap" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CloseWindow" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Height="{DynamicResource ButtonHeight}" Margin="0,0,10,0"/>
                    <Button Content="Apply Rename" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Width="170" Height="{DynamicResource ButtonHeight}"/>
                </StackPanel>
            </Grid>

        </Grid>
</base:LecgWindow>


