<base:LecgWindow x:Class="LECG.Views.DivideToposolidView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:LECG.Views.Base"
    xmlns:comp="clr-namespace:LECG.Views.Components"
    xmlns:controls="clr-namespace:LECG.Controls"
    xmlns:icons="clr-namespace:LECG.Utilities" Title="DIVIDE TOPOSOLID" Width="420" Height="520" MinWidth="360" MinHeight="460" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowIcon="{x:Static icons:Icons.Layers}">

    <base:LecgWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LECG;component/src/Resources/Themes/LecgTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:LecgWindow.Resources>

    <Grid Margin="{DynamicResource ViewContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMarginSmall}">
            <TextBlock Text="Divide Toposolid" Style="{DynamicResource TitleStyle}" Margin="{DynamicResource TitleMarginSmall}"/>
            <TextBlock Text="Split multi-layer toposolids into individual single-layer toposolids." FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LecgTextSecondary}"/>
        </StackPanel>

        <!-- Selection -->
        <Border Grid.Row="1" Padding="16" Margin="{DynamicResource HeaderMarginSmall}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource AccentBarStyle}"/>
                    <TextBlock Text="SELECTION" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                </StackPanel>
                <comp:SelectionControl DataContext="{Binding Selection}" Margin="0,0,0,12"/>
                <controls:ElementGridControl RowItems="{Binding RowItems}" Height="160"/>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Grid Grid.Row="2"/>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="{DynamicResource ButtonRowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Height="{DynamicResource ButtonHeight}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="Divide" Grid.Column="2" Height="{DynamicResource ButtonHeight}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}" Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</base:LecgWindow>
